datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------
// USER MANAGEMENT & NEXTAUTH
// ---------------------------------------------

enum Role {
  ADMIN
  OPERATION_MANAGER
  CLIENT
  AGENCY_MANAGER
  GUARD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  
  // Relations mapped for Role-Based Access Control
  managedAgencyId String? // Associated if role is AGENCY_MANAGER
  agency          Agency? @relation(fields: [managedAgencyId], references: [id])
  
  managedContracts Contract[] // Contracts the Client owns
  
  resolvedLogs    OperationLog[] @relation("ResolverLogs")
  
  guardProfile    Guard?
}

// NextAuth standard models (Accounts, Sessions, VerificationTokens typically go here)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------
// GUARDS & AGENCIES
// ---------------------------------------------

model Agency {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  managers  User[]   // Associated agency managers
  guards    Guard[]  // Guards registered under this third party
}

model Guard {
  id                 String @id @default(cuid())
  guardId            String @unique // Auto-generated human-readable ID
  firstName          String
  lastName           String
  certificateNumber  String?
  shiftPreference    String? // Day, Night, Flexible
  status             String   @default("Active") // Active, Suspended, On Leave
  contactNumber      String?
  certificationExpiry DateTime?
  skills             Json?    // Array of custom skills
  
  isVisibleToOps     Boolean  @default(false) // Agency toggle: make guard available for Ops deployment
  source             String   @default("IN_HOUSE") // "IN_HOUSE" or "AGENCY"
  
  agencyId           String? // Null if an in-house guard
  agency             Agency? @relation(fields: [agencyId], references: [id])

  userId             String? @unique
  user               User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rosters            SiteRoster[]
  replacements       ShiftException[] @relation("ReplacementGuardRelation")
  checkIns           OperationLog[]
}

// ---------------------------------------------
// CONTRACTS & SITES
// ---------------------------------------------

model Contract {
  id                   String   @id @default(cuid())
  clientCompanyName    String
  contactInfo          String
  durationMonths       Int
  startDate            DateTime
  endDate              DateTime
  usesThirdPartyAgency Boolean  @default(false)
  
  clientId             String
  client               User     @relation(fields: [clientId], references: [id])
  
  sites                Site[]
}

model Site {
  id          String @id @default(cuid())
  name        String
  perimeter   Json?  // Stores map perimeter (e.g., GeoJSON coordinates)
  shiftCount  Int    @default(2) // Represents if it is 2 or 3 shift cycle
  shiftTimings Json? // [{start: "08:00", end: "20:00"}, ...]
  
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  patrolPaths PatrolPath[]
  rosters SiteRoster[]
}

model SiteRoster {
  id         String @id @default(cuid())
  shiftLabel String // e.g. "Morning Shift"
  startTime  String   @default("08:00") // e.g., "08:00"
  endTime    String   @default("20:00") // e.g., "20:00"
  date       DateTime?
  status     String   @default("Scheduled") // "Scheduled", "Completed", etc.
  
  guardId    String
  guard      Guard @relation(fields: [guardId], references: [id])
  
  siteId     String
  site       Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  exceptions ShiftException[]
  logs       OperationLog[]
}

model ShiftException {
  id                 String @id @default(cuid())
  date               DateTime // The distinct date being modified
  type               String   @default("Absent") // "Absent", "Swap"
  
  rosterId           String
  roster             SiteRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  
  replacementGuardId String?
  replacementGuard   Guard?  @relation("ReplacementGuardRelation", fields: [replacementGuardId], references: [id])
}

// ---------------------------------------------
// PATROL MAPPING & LOGGING
// ---------------------------------------------

model PatrolPath {
  id       String @id @default(cuid())
  name     String // e.g., "Night Perimeter Search"
  
  siteId   String
  site     Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  pins     MapPin[]
}

model MapPin {
  id           String @id @default(cuid())
  name         String // e.g., "Front Gate", "Loading Dock"
  latitude     Float
  longitude    Float
  orderIndex   Int    // Order sequence within the path
  
  patrolPathId String
  patrolPath   PatrolPath @relation(fields: [patrolPathId], references: [id], onDelete: Cascade)
  
  checkIns     OperationLog[]
}

model OperationLog {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  isIncident  Boolean  @default(false) // Flags if this log is an incident report
  description String?
  resolved    Boolean  @default(false) // Operation Manager can mark incident as resolved
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?    @relation("ResolverLogs", fields: [resolvedById], references: [id])
  resolutionNote   String?
  
  guardId     String
  guard       Guard @relation(fields: [guardId], references: [id])
  
  mapPinId    String
  mapPin      MapPin @relation(fields: [mapPinId], references: [id], onDelete: Cascade)

  rosterId    String?
  roster      SiteRoster? @relation(fields: [rosterId], references: [id], onDelete: Cascade)
}
